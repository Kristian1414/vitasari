<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # File dan folder yang benar-benar ada dilayani apa adanya.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Sisanya diserahkan ke index.html supaya React Router yang membaca alamatnya.
  RewriteRule ^ index.html [L]
</IfModule>