<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Satu alamat resmi -----------------------------------------------------
  # Tanpa ini, http://vitasari.id, http://www.vitasari.id, dan
  # https://www.vitasari.id semuanya membalas halaman yang sama persis dengan
  # https://vitasari.id. Bagi Google itu empat situs kembar, dan nilai yang
  # seharusnya terkumpul di satu alamat terbagi empat. Tag canonical di <head>
  # hanya anjuran; pengalihan 301 benar-benar memindahkan.
  #
  # www lebih dulu, dan tujuannya langsung https, supaya http://www... selesai
  # dalam satu lompatan, bukan dua.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- Tolak hotlink gambar --------------------------------------------------
  # Mencegah situs lain memasang foto produk Vitasari langsung dari server ini.
  # Selain memakai kuota Anda, foto itu jadi tampil di halaman mereka seolah
  # miliknya. Yang ditolak hanya permintaan yang datang DARI halaman situs lain;
  # permintaan tanpa referer sengaja dibiarkan lewat, karena itulah yang dipakai
  # Googlebot, pratinjau tautan WhatsApp/Facebook, dan orang yang membuka alamat
  # fotonya langsung. Menutupnya juga akan membuat foto Anda hilang dari Google
  # Images dan pratinjau tautan jadi polos.
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?vitasari\.id [NC]
  RewriteRule \.(jpe?g|png|gif|webp|svg)$ - [F,NC]

  # --- Rute halaman ----------------------------------------------------------
  # File yang benar-benar ada (gambar, CSS, JavaScript) dilayani apa adanya.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Tiap halaman punya HTML jadi hasil prerender di folder senama, misalnya
  # /menu -> menu/index.html dan /cabang/buah-batu -> cabang/buah-batu/index.html.
  # Dilayani langsung dari alamat aslinya; kalau diserahkan ke penanganan folder
  # bawaan Apache, /menu akan dialihkan dulu ke /menu/ dan Google mencatat satu
  # pengalihan yang tidak perlu di tiap halaman.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

# --- Alamat yang tidak dikenal -----------------------------------------------
# Dibalas 404.html hasil prerender, dengan status 404 sungguhan.
#
# Sebelumnya semua alamat tak dikenal dijatuhkan ke index.html, sehingga salah
# ketik apa pun membalas status 200 berisi beranda. Google menyebutnya
# "soft 404" dan itu merugikan justru halaman yang dibalaskannya. Aturan lama
# itu tidak diperlukan lagi: semua halaman yang ada sudah punya berkas HTML-nya
# sendiri.
ErrorDocument 404 /404.html

# --- Jenis berkas -------------------------------------------------------------
# Foto produk versi ringan (public/images/products-web/) berformat WebP. Server
# lama kadang belum mengenalnya dan mengirimnya sebagai berkas biasa.
AddType image/webp .webp

# --- Umur simpan --------------------------------------------------------------
# Berkas di /assets/ dibubuhi sidik isi oleh Vite (index-a1b2c3.js): isinya
# berubah berarti namanya ikut berubah, jadi aman disimpan browser setahun.
# HTML sebaliknya tidak pernah berganti nama dan justru dialah yang menyebut
# nama-nama berkas baru itu, jadi selalu ditanyakan ulang ke server.
#
# Kecepatan muat ikut dihitung Google dalam peringkat, terutama di HP.
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType text/javascript          "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 month"
  ExpiresByType image/webp               "access plus 1 month"
  ExpiresByType image/png                "access plus 1 month"
  ExpiresByType image/svg+xml            "access plus 1 month"

  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType application/xml          "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Kompresi -----------------------------------------------------------------
# HTML hasil prerender berisi seluruh teks halamannya, dan teks memampat sangat
# baik. Foto sengaja tidak ikut: JPEG sudah terkompresi.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
